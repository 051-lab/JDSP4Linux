QWidget { font-size: 10pt; }
QPushButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox { border-radius: 3px; padding: 3px 6px; }
QPushButton:focus, QComboBox:focus, QLineEdit:focus { border: 1px solid palette(highlight); }
QTabBar::tab { padding: 5px 10px; }
QSlider::groove:horizontal { height: 4px; }
QSlider::handle:horizontal { width: 12px; margin: -4px 0; border-radius: 6px; }
